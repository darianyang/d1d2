   "source": [
    "# Write previous data\n",
    "with open(f'{model_name}/clusters_opt3.pickle','wb') as file:\n",
    "    pickle.dump(clusters, file)\n",
    "with open(f'{model_name}/dtrajs_opt3.pickle','wb') as file:\n",
    "    pickle.dump(dtrajs, file)"
   ]
  },
  {
   "cell_type": "code",
