    "# Make MSM for each cluster/lagtime\n",
    "estimator = deeptime.markov.msm.MaximumLikelihoodMSM(reversible=True, stationary_distribution_constraint=None)\n",
    "msms = []\n",
    "for matrix in countm:\n",
