   "metadata": {},
   "source": [
    "And convert dist into crisp assignments"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "099d23c1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Read previous data\n",
    "with open(f'{model_name}/final.pickle','rb') as file:\n",
    "    [final_cluster, final_dtrajs, final_count, final_msm] = pickle.load(file)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 172,
   "id": "040e3b94-c308-4665-af0b-c5c7c10e303c",
   "metadata": {},
   "outputs": [],
   "source": [
    "import networkx as nx"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0fa45796-340f-4469-99cc-e712b8d03460",
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax = plt.subplots(1, 1, figsize=(10, 10))\n",
    "\n",
    "threshold = 5e-3\n",
    "title = f\"Transition matrix with connectivity threshold {threshold:.0e}\"\n",
    "G = nx.DiGraph()\n",
    "ax.set_title(title)\n",
    "for i in range(final_msm.n_states):\n",
    "    G.add_node(i, title=f\"{i}\")\n",
    "for i in range(final_msm.n_states):\n",
    "    for j in range(final_msm.n_states):\n",
    "        if final_msm.transition_matrix[i, j] > threshold:\n",
    "            G.add_edge(i, j, title=f\"{final_msm.transition_matrix[i, j]:.3e}\")\n",
    "\n",
    "edge_labels = nx.get_edge_attributes(G, 'title')\n",
    "pos = nx.fruchterman_reingold_layout(G)\n",
    "nx.draw_networkx_nodes(G, pos, ax=ax)\n",
    "nx.draw_networkx_labels(G, pos, ax=ax, labels=nx.get_node_attributes(G, 'title'));\n",
    "nx.draw_networkx_edges(G, pos, ax=ax, arrowstyle='-|>',\n",
    "                       connectionstyle='arc3, rad=0.3');\n",
    "\n",
    "plt.savefig(f\"{model_name}/tmat_network.pdf\")"
   ]
  },
